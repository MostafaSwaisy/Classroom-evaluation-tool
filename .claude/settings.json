{
  "permissions": {
    "allow": [
      "Bash(python cli.py courses)",
      "Bash(python cli.py work:*)",
      "Bash(python cli.py pull:*)",
      "Bash(python cli.py prepare:*)",
      "Bash(python cli.py status:*)",
